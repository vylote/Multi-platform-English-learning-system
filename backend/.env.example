# ==============================================================================
# CẤU HÌNH MÁY CHỦ & MẠNG (SERVER & CORS)
# ==============================================================================
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# CƠ SỞ DỮ LIỆU & BỘ NHỚ ĐỆM (POSTGRESQL & REDIS TỪ DOCKER)
# Khớp với thông số trong file docker-compose.yml (user: postgres, pass: 3821, db: els_db)
# ==============================================================================
DATABASE_URL=postgresql://postgres:3821@localhost:5432/els_db
REDIS_URL=redis://localhost:6379

# ==============================================================================
# BẢO MẬT XÁC THỰC (JWT & HTTP-ONLY COOKIE)
# JWT_SECRET: Khóa bí mật ký token (bắt buộc phải có để đăng nhập/đăng ký)
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_els_2026
JWT_ACCESS_EXPIRES_IN=1d
COOKIE_NAME=access_token
SESSION_KEY_PREFIX=session:

# ==============================================================================
# TÍCH HỢP AI SINH ĐỀ THI (GROQ CLOUD API - TÙY CHỌN)
# Đăng ký lấy API key miễn phí tại: https://console.groq.com/keys
# NẾU ĐỂ TRỐNG: Hệ thống tự động chạy chế độ Offline Fallback từ CSDL (không cần internet)
# ==============================================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
