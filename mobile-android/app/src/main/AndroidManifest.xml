<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobileandroid">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.auth.LoginActivity" android:exported="false" />

        <!-- ===== MỚI ===== -->
        <activity android:name=".ui.auth.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.auth.TopicLessonActivity" android:exported="false" />
        <activity android:name=".ui.auth.ExamListActivity" android:exported="false" />
        <activity android:name=".ui.auth.TopicPickerActivity" android:exported="false" />
        <activity android:name=".ui.auth.ExamHistoryActivity" android:exported="false" />

        <!-- ===== MỚI: khu vực quản trị (chỉ ADMIN) ===== -->
        <activity android:name=".ui.admin.AdminHomeActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminUsersActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.AdminPermissionsActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminExamsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.AdminExamGenerateActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.AdminSettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ui.auth.HomeActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.ProfileActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.ProgressActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.LearnActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.VocabularyActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.DictionaryActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.GrammarActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.QuizActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
