<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    tools:context=".ui.auth.VocabularyActivity">

    <!-- ===== Header ===== -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#0F172A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Từ vựng"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/tvCardCounter"/>

    <TextView
        android:id="@+id/tvCardCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12/50"
        android:textColor="#64748B"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"/>

    <!-- ===== Progress bar tổng ===== -->
    <ProgressBar
        android:id="@+id/progressBarSession"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="100"
        android:progress="24"
        android:progressTint="#4F46E5"
        android:progressBackgroundTint="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- ===== Flashcard ===== -->
    <FrameLayout
        android:id="@+id/frameFlashcard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBarSession"
        app:layout_constraintBottom_toTopOf="@id/layoutActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <!-- ===== Mặt trước: Từ tiếng Anh ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvLevelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cơ bản"
                    android:textColor="#4F46E5"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="#E0E7FF"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <ImageButton
                    android:id="@+id/btnSpeak"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="#4F46E5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvWordFront"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Serendipity"
                    android:textColor="#0F172A"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ˌser.ənˈdɪp.ə.ti/"
                    android:textColor="#64748B"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/tvWordFront"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvTapHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chạm để xem nghĩa"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== Mặt sau: Nghĩa + ví dụ ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#4F46E5"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvWordBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Serendipity"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/tvMeaning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Sự tình cờ may mắn"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    app:layout_constraintTop_toBottomOf="@id/tvWordBack"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="12dp"/>

                <View
                    android:id="@+id/dividerBack"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#6366F1"
                    app:layout_constraintTop_toBottomOf="@id/tvMeaning"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:id="@+id/tvExampleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ví dụ"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toBottomOf="@id/dividerBack"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvExample"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="&quot;Meeting you here was pure serendipity.&quot;"
                    android:textColor="#E0E7FF"
                    android:textSize="14sp"
                    android:fontStyle="italic"
                    app:layout_constraintTop_toBottomOf="@id/tvExampleLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvTapHintBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chạm để xem lại từ"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- ===== Nút điều hướng trước/sau + đánh giá ===== -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp">

        <!-- Hàng đánh giá: Chưa nhớ / Đã nhớ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDontKnow"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Chưa nhớ"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#EF4444"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKnow"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Đã nhớ"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#52F800"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Hàng điều hướng: Trước / Sau -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/btnPrevious"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#94A3B8"/>

            <TextView
                android:id="@+id/tvSwipeHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vuốt hoặc dùng nút để chuyển thẻ"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"/>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_next"
                app:tint="#94A3B8"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== Bottom Navigation ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#4F46E5"
        app:itemTextColor="#4F46E5"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:elevation="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>