<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    tools:context=".ui.auth.QuizActivity">

    <!-- ===== Header ===== -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#0F172A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"/>

    <TextView
        android:id="@+id/tvQuestionCounter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Câu 1/10"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toEndOf="@id/btnClose"
        app:layout_constraintEnd_toStartOf="@id/tvTimer"/>

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱ 04:32"
        android:textColor="#EF4444"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"/>

    <!-- ===== Progress bar tổng ===== -->
    <ProgressBar
        android:id="@+id/progressBarQuiz"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="100"
        android:progress="10"
        android:progressTint="#4F46E5"
        android:progressBackgroundTint="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- ===== Nội dung câu hỏi (cuộn) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/progressBarQuiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnNextQuestion"
        android:layout_marginTop="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- ===== Card câu hỏi ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvQuestionType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngữ pháp"
                        android:textColor="#4F46E5"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="#E0E7FF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Chọn đáp án đúng để hoàn thành câu sau:\n\n&quot;She ___ to school every day.&quot;"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tvQuestionType"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="14dp"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== Các đáp án ===== -->
            <LinearLayout
                android:id="@+id/layoutOptions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/cardQuestion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="20dp">

                <!-- Đáp án A -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOptionLabelA"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="A"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:background="#E0E7FF"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvOptionTextA"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="go"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:layout_marginStart="14dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Đáp án B -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOptionLabelB"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="B"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:background="#E0E7FF"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvOptionTextB"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="goes"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:layout_marginStart="14dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Đáp án C -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOptionLabelC"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="C"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:background="#E0E7FF"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvOptionTextC"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="going"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:layout_marginStart="14dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Đáp án D -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvOptionLabelD"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="D"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:background="#E0E7FF"
                            android:gravity="center"/>

                        <TextView
                            android:id="@+id/tvOptionTextD"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="gone"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:layout_marginStart="14dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Nút tiếp theo ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextQuestion"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Câu tiếp theo"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:enabled="false"
        app:backgroundTint="#52F800"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"/>

    <!-- ===== Kết quả bài thi (ẩn ban đầu) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvResultEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="56sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="40dp"/>

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoàn thành bài thi!"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintTop_toBottomOf="@id/tvResultEmoji"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardScoreResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#4F46E5"
                app:layout_constraintTop_toBottomOf="@id/tvResultTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/tvResultScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="8/10"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:padding="28dp"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvResultCorrect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Đúng: 8 câu"
                android:textColor="#0F172A"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/cardScoreResult"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/tvResultWrong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sai: 2 câu"
                android:textColor="#EF4444"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvResultCorrect"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewAnswers"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="Xem lại đáp án"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#4F46E5"
                app:backgroundTint="#E0E7FF"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvResultWrong"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="32dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishQuiz"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="Hoàn tất"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#52F800"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/btnReviewAnswers"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>