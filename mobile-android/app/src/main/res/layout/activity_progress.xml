<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    tools:context=".ui.auth.ProgressActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- ===== Header ===== -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiến độ học tập"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"/>

            <!-- ===== Card tổng quan ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOverview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#4F46E5"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvOverviewTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Tổng tiến độ khóa học"
                        android:textColor="#E0E7FF"
                        android:textSize="13sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvOverviewPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="68%"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-black"
                        app:layout_constraintTop_toBottomOf="@id/tvOverviewTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="6dp"/>

                    <ProgressBar
                        android:id="@+id/progressBarOverview"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="68"
                        android:progressTint="#52F800"
                        android:progressBackgroundTint="#6366F1"
                        app:layout_constraintTop_toBottomOf="@id/tvOverviewPercent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="14dp"/>

                    <!-- Hàng số liệu nhỏ -->
                    <TextView
                        android:id="@+id/tvStatLessons"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="34/50\nBài học"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/progressBarOverview"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvStatStreak"
                        android:layout_marginTop="16dp"/>

                    <TextView
                        android:id="@+id/tvStatStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="7\nNgày streak"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="@id/tvStatLessons"
                        app:layout_constraintStart_toEndOf="@id/tvStatLessons"
                        app:layout_constraintEnd_toStartOf="@id/tvStatTime"/>

                    <TextView
                        android:id="@+id/tvStatTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="12h30\nThời gian học"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="@id/tvStatLessons"
                        app:layout_constraintStart_toEndOf="@id/tvStatStreak"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== Tiêu đề: Hoạt động trong tuần ===== -->
            <TextView
                android:id="@+id/tvSectionWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoạt động trong tuần"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintTop_toBottomOf="@id/cardOverview"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"/>

            <!-- ===== Card biểu đồ tuần ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWeekly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/tvSectionWeekly"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp"
                    android:weightSum="7">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barMon"
                            android:layout_width="14dp"
                            android:layout_height="40dp"
                            android:background="#C7D2FE"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T2"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barTue"
                            android:layout_width="14dp"
                            android:layout_height="60dp"
                            android:background="#C7D2FE"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T3"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barWed"
                            android:layout_width="14dp"
                            android:layout_height="30dp"
                            android:background="#C7D2FE"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T4"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barThu"
                            android:layout_width="14dp"
                            android:layout_height="70dp"
                            android:background="#4F46E5"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T5"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barFri"
                            android:layout_width="14dp"
                            android:layout_height="50dp"
                            android:background="#C7D2FE"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T6"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barSat"
                            android:layout_width="14dp"
                            android:layout_height="20dp"
                            android:background="#C7D2FE"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T7"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:id="@+id/barSun"
                            android:layout_width="14dp"
                            android:layout_height="45dp"
                            android:background="#52F800"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CN"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== Tiêu đề: Tiến độ theo kỹ năng ===== -->
            <TextView
                android:id="@+id/tvSectionSkills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiến độ theo kỹ năng"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintTop_toBottomOf="@id/cardWeekly"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"/>

            <!-- ===== Card danh sách kỹ năng ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSkills"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/tvSectionSkills"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Từ vựng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📖"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Từ vựng"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="10dp"/>

                        <TextView
                            android:id="@+id/tvVocabPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressVocab"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="80"
                        android:progressTint="#4F46E5"
                        android:progressBackgroundTint="#E2E8F0"
                        android:layout_marginTop="8dp"/>

                    <!-- Ngữ pháp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngữ pháp"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="10dp"/>

                        <TextView
                            android:id="@+id/tvGrammarPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65%"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressGrammar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="65"
                        android:progressTint="#4F46E5"
                        android:progressBackgroundTint="#E2E8F0"
                        android:layout_marginTop="8dp"/>

                    <!-- Kiểm tra -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="16sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kiểm tra"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="10dp"/>

                        <TextView
                            android:id="@+id/tvQuizPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72%"
                            android:textColor="#4F46E5"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressQuiz"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="72"
                        android:progressTint="#4F46E5"
                        android:progressBackgroundTint="#E2E8F0"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Bottom Navigation ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#4F46E5"
        app:itemTextColor="#4F46E5"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:elevation="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>